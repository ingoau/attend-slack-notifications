{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attend-slack-notifications",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // How often to check Attend for new sign-ups. Every 5 minutes by default.
  "triggers": { "crons": ["*/5 * * * *"] },

  // Holds the rotating Attend token and the list of people already announced.
  // SQLite-backed, so it works on the Workers free plan and needs no setup.
  "durable_objects": {
    "bindings": [{ "name": "POLLER", "class_name": "Poller" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Poller"] }],

  // All settings (ATTEND_EVENT, MESSAGE_TEMPLATE, ...) are set on Cloudflare, not here:
  // `npx wrangler secret put <NAME>` or the dashboard's Variables and Secrets. keep_vars stops
  // a redeploy from wiping the ones set in the dashboard. See README.md for every option.
  "keep_vars": true
}
