# Required. For local dev copy this file to .dev.vars; in production use `npx wrangler secret put <NAME>`
# (or the Cloudflare dashboard → Variables and Secrets). See README.md for every option.
ATTEND_TOKEN=
SLACK_WEBHOOK_URL=
ATTEND_EVENT=
# Optional. The Deploy to Cloudflare form won't take a blank value, so `none` / `default` mean unset.
ADMIN_KEY=none
ALERT_WEBHOOK_URL=default
MESSAGE_TEMPLATE=default
SUMMARY_TEMPLATE=default
SLACK_PAYLOAD_TEMPLATE=none
