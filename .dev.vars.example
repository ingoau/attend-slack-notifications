# Required. For local dev copy this file to .dev.vars; in production use `npx wrangler secret put <NAME>`
# (or the Cloudflare dashboard → Variables and Secrets). See README.md for every option.
ATTEND_TOKEN=
SLACK_WEBHOOK_URL=
ATTEND_EVENT=
# Optional
ADMIN_KEY=
ALERT_WEBHOOK_URL=
# Optional message templates. Leave blank for the defaults (see README.md for every placeholder).
MESSAGE_TEMPLATE=
SUMMARY_TEMPLATE=
